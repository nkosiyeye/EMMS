@using EMMS.Utility
@using Newtonsoft.Json
@using static EMMS.Models.Enumerators
@*
    Messages the server left for the user in TempData, shown as toasts by site.js (emmsToast).
    Both layouts render this, so every page (login included) shows messages the same way.
    A new message key goes in this list; views don't render TempData messages themselves.
*@
@{
    var keys = new (string Key, string Type)[]
    {
        ("Success", "success"),
        ("MovementSuccess", "success"),
        ("UserRegistrationSuccess", "success"),
        ("QueueInfo", "info"),
        ("Error", "danger"),
        ("CylinderError", "danger"),
        ("JobError", "danger"),
        ("JobPartError", "danger"),
        ("LookupError", "danger"),
        ("MovementError", "danger"),
        ("QueueErrors", "danger"),
        ("RegistrationError", "danger"),
        ("UserCreationError", "danger"),
        ("UserEditError", "danger"),
        ("UserRegistrationError", "danger"),
        ("WorkDoneError", "danger"),
        ("WorkRequestError", "danger"),
    };

    var toasts = keys
        .Select(k => new { message = TempData[k.Key] as string, type = k.Type })
        .Where(t => !string.IsNullOrWhiteSpace(t.message))
        .ToList();

    // TempData["Notification"] holds a serialised ToastNotification (login and password reset)
    if (TempData["Notification"] is string json && JsonConvert.DeserializeObject<ToastNotification>(json) is { } notification)
    {
        toasts.Add(new { message = (string?)notification.Message, type = notification.Type == NotificationType.Error ? "danger" : "success" });
    }
}
@if (toasts.Count > 0)
{
    <script type="application/json" id="emms-server-toasts">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(toasts))</script>
}
