@using EMMS.Utility
@using static EMMS.Models.Enumerators
@model EMMS.ViewModels.AssetIndexViewModel
@{

    ViewData["Title"] = "Manage Assets";
    ViewData["asset"] = "active";
    var isAdmin = ViewBag._currrentUserRole.UserType == Enumerators.UserType.Administrator;
    var isBiomed = ViewBag._currrentUserRole.UserType == Enumerators.UserType.Biomed;
    var isDataCollector = ViewBag._currrentUserRole?.UserType == Enumerators.UserType.DataCollector;
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><strong>Manage Assets</strong></span>
        <div class="d-flex align-items-center">
            <a class="btn btn-primary btn-sm me-2 @(isAdmin || isBiomed ? "" : "d-none")" asp-controller="AssetManagement" asp-action="registerAsset">
                <i class="fa fa-plus me-1"></i> New Asset
            </a>
            <a class="btn btn-primary btn-sm me-2 @(isAdmin || isBiomed || isDataCollector ? "" : "d-none")" asp-controller="AssetManagement" asp-action="quickRegisterAsset">
                <i class="fa fa-plus me-1"></i> Add Muliple Assets
            </a>
            <button type="button" id="clearFilters" class="btn btn-outline-secondary btn-sm me-2 d-none" title="Reset all column filters">
                <i class="fa fa-filter-circle-xmark me-1"></i> Clear Filters
            </button>
            <button type="button" id="clearSelection" class="btn btn-link btn-sm d-none" title="Clear selection">
                Clear selection
            </button>
            <button type="button" id="moveSelected" class="btn btn-primary btn-sm me-2 @(isDataCollector ? "d-none" : "")" title="Add the selected assets to the Movement Queue" disabled>
                <i class="fa fa-arrows-alt me-1"></i> Move Selected (<span class="selected-count">0</span>)
            </button>
            <button type="button" id="printSelected" class="btn btn-secondary btn-sm @(isAdmin || isBiomed ? "" : "d-none")" title="Print Stickers" disabled>
                <i class="fa fa-print me-1"></i> Print Stickers for Selected (<span class="selected-count">0</span>)
            </button>
        </div>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover" id="assetTable">
                <thead class="table-dark">
                    <tr>
                        <th><input type="checkbox" id="selectAllAssets" title="Select all on this page" /></th>
                        <th>Tag</th>
                        <th>Category</th>
                        <th>Item Name</th>
                        <th>Placement</th>
                        <th>Vendor</th>
                        <th>Service Provider</th>
                        <th>Procurement</th>
                        <th>Facility</th>
                        <th>Service Point</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    /* Column filter dropdowns in the dark header */
    #assetTable thead th {
        vertical-align: top;
    }

    #assetTable thead select.column-filter {
        width: 100%;
        max-width: 160px;
        margin-top: 4px;
        font-size: 0.8rem;
    }

        #assetTable thead select.column-filter option {
            background-color: #fff;
            color: #212529;
        }
</style>

<div class="modal fade" id="stolenMissingModal" tabindex="-1" aria-labelledby="stolenMissingLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="stolenMissingForm" method="post" asp-controller="AssetMovement" asp-action="ReportStolenMissing">
                <div class="modal-header bg-danger text-white">
                    <h6 class="modal-title" id="stolenMissingLabel">
                        Report Stolen/Missing Asset
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="AssetId" id="assetId" />
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Asset Tag</label>
                            <input type="text" class="form-control" id="assetTag" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Category</label>
                            <input type="text" class="form-control" id="assetCategory" readonly />
                        </div>

                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Item Name</label>
                            <input type="text" class="form-control" id="assetName" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Serial / Model</label>
                            <input type="text" class="form-control" id="assetSerialModel" readonly />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Current Location</label>
                        <input type="text" class="form-control" id="assetLocation" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Police Docket Number</label>
                        <input type="text" class="form-control" name="DocketNumber" required />
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger">
                        <i class="fa fa-check me-1"></i> Submit Report
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>




@section Scripts {
    <script>
        $(document).ready(function () {
            // Multi-select actions: selection is kept by tag across server-side pages,
            // so a facility without a scanner can tick assets and act on them in bulk.
            const selectedAssetTags = new Set();

            var isTabletOrSmaller = window.innerWidth <= 1024;

            function syncSelection() {
                const boxes = $('#assetTable tbody .asset-checkbox');
                boxes.each(function () { this.checked = selectedAssetTags.has(this.value); });
                $('#selectAllAssets').prop('checked', boxes.length > 0 && boxes.filter(':checked').length === boxes.length);
                $('.selected-count').text(selectedAssetTags.size);
                $('#printSelected, #moveSelected').prop('disabled', selectedAssetTags.size === 0);
                $('#clearSelection').toggleClass('d-none', selectedAssetTags.size === 0);
            }

            // Show "Clear Filters" only when at least one column filter is applied
            function syncFilterState() {
                const hasFilters = $('#assetTable thead select.column-filter').toArray()
                    .some(s => s.value !== '');
                $('#clearFilters').toggleClass('d-none', !hasFilters);
            }

            $('#assetTable').DataTable({
                serverSide: true,
                processing: true,
                ajax: {
                    url: '@Url.Action("GetAssets", "AssetManagement")',
                    type: 'POST',
                    dataSrc: 'data'
                },
                pageLength: 10,
                responsive: isTabletOrSmaller,
                drawCallback: function () {
                    syncSelection();
                    syncFilterState();
                },
                columns: [
                    { data: "checkbox", orderable: false, searchable: false },
                    { data: "tag" },
                    { data: "category", name: "Category" },
                    { data: "itemName" },
                    { data: "placement", name: "Placement" },
                    { data: "vendor", name: "Vendor" },
                    { data: "serviceProvider", name: "Service Provider" },
                    { data: "procurement", name: "Procurement" },
                    { data: "facility", name: "Facility" },
                    { data: "servicePoint" },
                    { data: "status", name: "Status" },
                    { data: "action", orderable: false, searchable: false }
                ],
                initComplete: function () {
                    this.api()
                        .columns([2, 4, 5, 6, 8, 10])   // Category, Placement, Vendor, Service Provider, Facility, Status
                        .every(function () {
                            const column = this;
                            const select = document.createElement('select');
                            select.add(new Option('All', ''));
                            select.className = 'form-select form-select-sm column-filter';
                            $(column.header()).append(select);

                            // keep the header click from triggering the column sort
                            select.addEventListener('click', e => e.stopPropagation());

                            select.addEventListener('change', () => {
                                const val = select.value;
                                column
                                    .search(val ? '^' + val.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '$' : '', true, false)
                                    .draw();
                            });

                            // NOTE: with serverSide, this only lists values on the current page.
                            column.data().unique().sort().each(function (d) {
                                select.add(new Option(d, d));
                            });
                        });

                    // Clear all column filters at once
                    $('#clearFilters').on('click', function () {
                        $('#assetTable thead select.column-filter').each(function () {
                            this.value = '';
                        });
                        const api = $('#assetTable').DataTable();
                        api.columns([2, 4, 5, 6, 8, 10]).search('').draw();
                    });
                }
            });

            $('#assetTable').on('change', '.asset-checkbox', function () {
                this.checked ? selectedAssetTags.add(this.value) : selectedAssetTags.delete(this.value);
                syncSelection();
            });

            $('#selectAllAssets').on('change', function () {
                const check = this.checked;
                $('#assetTable tbody .asset-checkbox').each(function () {
                    check ? selectedAssetTags.add(this.value) : selectedAssetTags.delete(this.value);
                });
                syncSelection();
            });

            $('#clearSelection').on('click', function () {
                selectedAssetTags.clear();
                syncSelection();
            });

            $('#printSelected').on('click', function () {
                printSelectedStickers(Array.from(selectedAssetTags));
            });

            // Same checks as scanning; results are shown on the Movement Queue page
            $('#moveSelected').on('click', function () {
                emmsPostTags('/AssetMovement/QueueAddSelected', Array.from(selectedAssetTags));
            });

            $(document).on("click", ".stolen-missing-btn", function () {
                $("#assetId").val($(this).data("id"));
                $("#assetTag").val($(this).data("tag"));
                $("#assetName").val($(this).data("name"));
                $("#assetCategory").val($(this).data("category"));
                $("#assetSerialModel").val($(this).data("serial") + " / " + $(this).data("model"));
                $("#assetLocation").val($(this).data("location"));

                $("#stolenMissingModal").modal("show");
            });
        });
    </script>
}
