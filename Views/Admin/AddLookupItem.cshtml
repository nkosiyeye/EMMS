@model EMMS.ViewModels.Admin.LookupViewModel;
@{
}
<div class="container">
    <div class="d-flex justify-content-center">
        <div class="card col-md-6 mb-6">
            <div class="card-header">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Add @Model.LookupList?.Name Item</span>
                </div>
            </div>
            <div class="card-body">
                @if (TempData["LookupError"] != null)
                {
                    <div class="row alert alert-danger d-flex align-items-center alert-dismissible fade show" role="alert">
                        @TempData["LookupError"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                <form asp-action="AddLookupItem" asp-controller="Admin" method="post">
                    <div class="row">
                        <input type="hidden" asp-for="_lookupItem.LookupListId" value="@Model.LookupList?.LookupListId" />
                        <div class="mb-3">
                            <label asp-for="_lookupItem.Name" for="Name" class="form-label required-field">Item Name</label>
                            <input asp-for="_lookupItem.Name" type="text" class="form-control" id="Name" required />
                            <span asp-validation-for="_lookupItem.Name" class="text-danger"></span>
                        </div>
                        @if (Model._lookupItems != null && Model._lookupItems.Any())
                        {
                            <div class="mb-3">
                                <label for="ParentId" class="form-label">Parent</label>
                                <select asp-for="_lookupItem.ParentId" id="category" class="form-select selectpicker col-md-6">
                                    @foreach (var lookup in Model._lookupItems)
                                    {
                                        <option value="@lookup.Id">@lookup.Name</option>
                                    }
                                </select>
                            </div>
                        }
                        else if (Model._facilities != null && Model._facilities.Any())
                        {
                            <div class="mb-3">
                                <label for="ParentFacilityId" class="form-label">Facility <span class="text-muted small">(if necessary)</span></label>
                                <select asp-for="_lookupItem.ParentFacilityId" id="facility" class="form-select selectpicker col-md-6">
                                    <option value="" selected>Select For Specific Facility</option>
                                    @foreach (var facility in Model._facilities)
                                    {
                                        <option value="@facility.FacilityId">@facility.FacilityName</option>
                                    }
                                </select>
                            </div>
                        }
                        @if (Model.LookupList?.Name == "SubCategory")
                        {
                            <div class="mb-3">
                                <label class="form-label d-block">Configuration Flags</label>
                                <div class="border rounded p-3 bg-light">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input flag-checkbox" id="flag_RequiresSerial" data-flag="RequiresSerial">
                                        <label class="form-check-label fw-bold" for="flag_RequiresSerial">
                                            Requires Serial Number
                                        </label>
                                        <div class="form-text text-muted">If checked, assets of this type will require a serial number during registration.</div>
                                    </div>
                                </div>

                                <input type="hidden" asp-for="_lookupItem.FlagsJson" id="FlagsJson" />
                            </div>
                        }

                        <div class="mb-3">
                            <label asp-for="_lookupItem.RowState" for="RowState" class="form-label">Status</label>
                            <select asp-for="_lookupItem.RowState" class="form-select" id="RowState">
                                <option value="1" selected>Active</option>
                                <option value="2">Inactive</option>
                                <option value="0">Deleted</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">Add Item</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const flagsInput = document.getElementById('FlagsJson');
            const checkboxes = document.querySelectorAll('.flag-checkbox');

            // 1. Initialize checkboxes from existing JSON
            if (flagsInput.value) {
                try {
                    const currentFlags = JSON.parse(flagsInput.value);
                    checkboxes.forEach(cb => {
                        const flagName = cb.dataset.flag;
                        if (currentFlags[flagName] === true) {
                            cb.checked = true;
                        }
                    });
                } catch (e) {
                    console.error("Error parsing FlagsJson:", e);
                }
            }

            // 2. Update the JSON string whenever a checkbox is toggled
            // Or alternatively, do it right before the form submits
            const form = flagsInput.closest('form');
            form.addEventListener('submit', function () {
                let flagsObj = {};
                checkboxes.forEach(cb => {
                    const flagName = cb.dataset.flag;
                    flagsObj[flagName] = cb.checked;
                });

                // Set the hidden input value to the JSON string
                flagsInput.value = JSON.stringify(flagsObj);
            });
        });
    </script>
}

