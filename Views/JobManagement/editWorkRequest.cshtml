@using EMMS.ViewModels
@model WorkRequestViewModel
@{
    ViewData["Title"] = "Edit Work Request";
}

<div class="card mb-12">
    <div class="card-header">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Edit Work Request</span>
        </div>
    </div>
    <div class="card-body">
        <form asp-action="editWorkRequest" asp-controller="JobManagement" method="post">
            <div class="row mb-2">

                <!-- Date -->
                <div class="col-md-6">
                    <input asp-for="WorkRequest.WorkRequestId" type="hidden" />
                    <label asp-for="WorkRequest.RequestDate" for="requestDate" class="form-label required-field">Request Date</label>
                    <input asp-for="WorkRequest.RequestDate" type="date" class="form-control" id="requestDate" max="@DateTime.Today.ToString("yyyy-MM-dd")" required>
                    <span asp-validation-for="WorkRequest.RequestDate" class="text-danger"></span>
                </div>

                <!-- Asset Name / Tag -->
                <div class="col-md-6">
                    <label asp-for="WorkRequest.AssetId" class="form-label required-field"></label>
                    <input asp-for="WorkRequest.AssetId" class="form-control" type="Guid" hidden />
                    <input class="form-control" type="text" value="@($"{Model.WorkRequest!.Asset?.AssetTagNumber} - {Model.WorkRequest.Asset?.SubCategory?.Name}" )" disabled />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-6">
                    <label asp-for="WorkRequest.WorkStatusId" for="title" class="form-label required-field"></label>
                    <input class="form-control" type="text" value="@(Model.WorkStatuses?.FirstOrDefault(w => w.Name == "Open")?.Name ?? "Open")" disabled />
                </div>
                <div class="col-md-6">
                    <label asp-for="WorkRequest.FacilityId" class="form-label"></label>
                    <input class="form-control" value="@Model.WorkRequest.Facility?.FacilityName" readonly />
                </div>
            </div>

            <div class="col-md-12 mb-2">
                <label asp-for="WorkRequest.Description" for="faultDescription" class="form-label required-field">Fault Description</label>
                <textarea asp-for="WorkRequest.Description" class="form-control" id="faultDescription" rows="2" placeholder="Brief description of the problem"></textarea>
                <span asp-validation-for="WorkRequest.Description" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                <button type="submit" class="btn btn-primary">Save changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

