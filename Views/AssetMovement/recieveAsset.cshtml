        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Confirm Receiption Form</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                @* @if (TempData["Error"] != null)
                {
                    <div class="row alert alert-primary d-flex align-items-center alert-dismissible fade show" role="alert">
                        <div>
                            <svg class="bi flex-shrink-0 me-2" role="img" aria-label="Info:"><use xlink:href="#info-fill" /></svg>
                            <div>
                                @TempData["Error"]
                            </div>
                        </div>

                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>

                } *@
                <form asp-action="ReceiveAsset" asp-controller="AssetMovement" method="post">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="MoveAsset.Asset.AssetTagNumber" class="form-label"></label>
                            <input asp-for="MoveAsset.MovementId" id="movementId" type="hidden" />
                            <input id="assetTag" class="form-control" readonly/>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MoveAsset.DateReceived" class="form-label"></label>
                            <input asp-for="MoveAsset.DateReceived" class="form-control" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="MoveAsset.ConditionId" class="form-label"></label>
                             <select asp-for="MoveAsset.ConditionId" class="form-select selectpicker col-md-6"
                                    data-live-search="true" asp-items="@(new SelectList(Model.Conditions, "Id", "Name"))">
                                <option selected disabled>Select Condition</option>
                            </select> 
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MoveAsset.ReceivedBy" class="form-label"></label>
                            <input asp-for="MoveAsset.ReceivedBy" type="hidden" class="form-control" value="@ViewBag._currentUser.UserId" readonly />
                            <input class="form-control" value="@ViewBag._currentUser.FirstName" readonly />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label asp-for="MoveAsset.Remarks" class="form-label"></label>
                            <textarea asp-for="MoveAsset.Remarks" class="form-control"></textarea>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">Recieve</button>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>

    <script>

            
    </script>
</div>
<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Confirm Rejection Form</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form asp-action="rejectAsset" asp-controller="AssetMovement" method="post">
                    <div class="row mb-3">
                        <!-- Date -->
                        <div class="col-md-6">
                            <label for="rejectedDate" class="form-label required-field">Date Rejected</label>
                            <input asp-for="MoveAsset.DateRejected" type="date" class="form-control" id="movementDate" required>
                        </div>
                        <!-- Asset Name / Tag -->
                        <div class="col-md-6">
                            <label for="rejectassetId" class="form-label required-field">Asset Name / Tag</label>
                            <input asp-for="MoveAsset.MovementId" id="rejectmovementId" type="hidden" />
                            <input type="text" value="Patient Monitor - AS-001" class="form-control" id="rejectassetId" required readonly>
                            <!-- Populate dynamically -->
                        </div>

                    </div>
                    <div class="row mb-3">

                        <div class="col-md-6">
                            <label asp-for="MoveAsset.RejectedBy" class="form-label"></label>
                            <input asp-for="MoveAsset.RejectedBy" type="hidden" class="form-control" value="@ViewBag._currentUser.UserId" readonly />
                            <input class="form-control" value="@ViewBag._currentUser.FirstName" readonly />
                        </div>


                        <!-- Reason -->
                        <div class="col-md-6">
                            <label asp-for="MoveAsset.RejectedReasonId" class="form-label required-field">Rejected Reason</label>
                            <select asp-for="MoveAsset.RejectedReasonId" class="form-select selectpicker col-md-6"
                                    data-live-search="true" asp-items="@(new SelectList(Model.Reasons, "Id", "Name"))">
                                <option selected disabled>Select Reason</option>
                            </select>
                        </div>
                        </div>

                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label asp-for="MoveAsset.Remarks" class="form-label"></label>
                            <textarea asp-for="MoveAsset.Remarks" class="form-control"></textarea>
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-primary">Reject</button>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            // ── Scan to Receive ──────────────────────────────────────────────
            (function () {
                const batchSelect = document.getElementById('srBatch');
                const scanInput = document.getElementById('srScan');
                const tbody = document.getElementById('srItems');
                let items = [];   // { movementId, tag, serial, itemName, received, ticked }
                let batches = [];

                function esc(text) { const d = document.createElement('div'); d.textContent = text ?? ''; return d.innerHTML; }

                function pending() { return items.filter(i => !i.received); }

                function render() {
                    const open = pending();
                    const ticked = open.filter(i => i.ticked).length;
                    tbody.innerHTML = items.map(i => `
                        <tr class="${i.received ? 'table-light text-muted' : (i.ticked ? '' : 'table-danger')}" data-id="${i.movementId}">
                            <td><input type="checkbox" class="form-check-input sr-tick" ${i.received ? 'checked disabled' : (i.ticked ? 'checked' : '')} aria-label="Received ${esc(i.tag)}"></td>
                            <td>${esc(i.tag)}</td>
                            <td>${esc(i.serial)}</td>
                            <td>${esc(i.itemName)}</td>
                            <td>${i.received ? '<span class="text-muted">already received</span>' : (i.ticked ? '<span class="text-success"><i class="fa fa-check-circle"></i> received</span>' : '<span class="text-danger"><i class="fa fa-exclamation-triangle"></i> not yet scanned</span>')}</td>
                        </tr>`).join('');
                    const counter = document.getElementById('srCounter');
                    counter.textContent = `Scanned ${ticked} / ${open.length}`;
                    counter.className = 'mb-3 ' + (ticked === open.length ? 'text-success' : 'text-danger');
                    document.getElementById('srConfirmCount').textContent = `${ticked} of ${open.length}`;
                    document.getElementById('srConfirm').disabled = ticked === 0;
                    document.getElementById('srNote').classList.toggle('d-none', ticked === 0 || ticked === open.length);
                }

                function showResult(ok, message) {
                    const el = document.getElementById('srResult');
                    el.className = 'small mb-3 fw-semibold ' + (ok ? 'text-success' : 'text-danger');
                    el.textContent = message;
                    emmsBeep(ok);
                }

                function scan(raw) {
                    const tag = (raw || '').trim().toUpperCase();
                    if (!tag) return;
                    const item = items.find(i => (i.tag || '').toUpperCase() === tag);
                    if (!item) showResult(false, `${tag} is not in this batch.`);
                    else if (item.received) showResult(false, `${item.tag} was already received.`);
                    else if (item.ticked) showResult(false, `${item.tag} is already scanned.`);
                    else { item.ticked = true; showResult(true, `Received ${item.tag} - ${item.itemName || ''}`); }
                    render();
                    scanInput.value = '';
                    scanInput.focus();
                }

                function loadBatch(batchId) {
                    const batch = batches.find(b => b.batchId === batchId);
                    document.getElementById('srBody').classList.toggle('d-none', !batch);
                    document.getElementById('srBatchLabel').textContent = batch ? `- Batch ${batch.label}` : '';
                    if (!batch) return;
                    document.getElementById('srFrom').textContent = `From ${batch.from} · expecting ${batch.pending} asset(s)`;
                    fetch(`/AssetMovement/BatchReceiveItems/${batchId}`).then(r => r.json()).then(data => {
                        items = data.map(i => ({ ...i, ticked: false }));
                        render();
                        scanInput.focus();
                    });
                }

                fetch('/AssetMovement/IncomingBatches').then(r => r.json()).then(data => {
                    batches = data;
                    document.getElementById('srEmpty').classList.toggle('d-none', data.length > 0);
                    batchSelect.innerHTML = data.length
                        ? data.map(b => `<option value="${b.batchId}">${esc(b.label)} - ${esc(b.from)} (${b.pending})</option>`).join('')
                        : '<option value="">No incoming batches</option>';
                    batchSelect.disabled = data.length === 0;
                    if (data.length) loadBatch(data[0].batchId);
                });

                batchSelect.addEventListener('change', () => loadBatch(batchSelect.value));
                scanInput.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); scan(scanInput.value); } });
                tbody.addEventListener('change', e => {
                    if (!e.target.classList.contains('sr-tick')) return;
                    const item = items.find(i => i.movementId === e.target.closest('tr').dataset.id);
                    if (item) { item.ticked = e.target.checked; render(); }
                });
                if (emmsCameraScanSupported()) {
                    const cam = document.getElementById('srCamera');
                    cam.classList.remove('d-none');
                    cam.addEventListener('click', () => emmsOpenCameraScanner(scan));
                }

                document.getElementById('srConfirm').addEventListener('click', async function () {
                    const open = pending();
                    const ticked = open.filter(i => i.ticked);
                    const missing = open.length - ticked.length;
                    if (missing > 0 && !(await emmsConfirm(
                        `${missing} asset(s) were not scanned. They will stay in transit and be flagged for follow-up. Continue?`,
                        { okText: 'Receive the rest' }))) return;
                    this.disabled = true;
                    const response = await fetch('/AssetMovement/ReceiveBatch', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            batchId: batchSelect.value,
                            movementIds: ticked.map(i => i.movementId),
                            conditionId: document.getElementById('srCondition').value || null,
                            remarks: document.getElementById('srRemarks').value || null
                        })
                    });
                    const result = await response.json().catch(() => ({}));
                    if (!response.ok) {
                        emmsToast((result.errors || ['The receipt could not be saved.']).join('\n'), 'danger');
                        this.disabled = false;
                        return;
                    }
                    emmsToastAfterReload(`${result.received} asset(s) received` + (result.flagged ? `; ${result.flagged} flagged for follow-up.` : '.'),
                        result.flagged ? 'warning' : 'success');
                    window.location.reload();
                });
            })();

            // ── Pending Receipts Table ───────────────────────────────────────
            $('#pendingReception').DataTable({
                serverSide: true,
                processing: true,
                ajax: {
                    url: '@Url.Action("GetPendingReceipts", "AssetMovement")',
                    type: 'POST'
                },
                pageLength: 10,
                order: [[3, 'desc']], // default sort by Date Sent
                columns: [
                    { data: 'assetTag' },
                    { data: 'fromFacility' },
                    { data: 'servicePoint' },
                    { data: 'dateSent' },
                    { data: 'funcStatus' },
                    { data: 'reason' },
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        render: function (data, type, row) {
                            return `
                                <button class="btn btn-sm btn-success me-1 receive-btn"
                                        data-bs-toggle="modal"
                                        data-bs-target="#recieveModal"
                                        data-movement-id="${row.movementId}"
                                        data-asset-tag="${row.assetTag}">
                                    <i class="fa fa-check-circle"></i> Receive
                                </button>
                                <button class="btn btn-sm btn-danger reject-btn"
                                        data-bs-toggle="modal"
                                        data-bs-target="#rejectModal"
                                        data-movement-id="${row.movementId}"
                                        data-asset-tag="${row.assetTag}">
                                    <i class="fa fa-times-circle"></i> Reject
                                </button>
                            `;
                        }
                    }
                ]
            });

            // ── Receipt History Table ────────────────────────────────────────
            $('#receptionHistory').DataTable({
                serverSide: true,
                processing: true,
                ajax: {
                    url: '@Url.Action("GetReceiptHistory", "AssetMovement")',
                    type: 'POST'
                },
                pageLength: 10,
                order: [[3, 'desc']], // sort by Date Received
                columns: [
                    { data: 'assetTag' },
                    { data: 'fromFacility' },
                    { data: 'servicePoint' },
                    { data: 'dateReceived' },
                    { data: 'dateRejected' },
                    { data: 'funcStatus' }
                ]
            });

            // Modal population (same as before, but using class selectors)
            const receiveModal = document.getElementById("recieveModal");
            receiveModal?.addEventListener("show.bs.modal", function (event) {
                const button = event.relatedTarget;
                document.getElementById("movementId").value   = button.getAttribute("data-movement-id");
                document.getElementById("assetTag").value     = button.getAttribute("data-asset-tag");
            });

            const rejectModal = document.getElementById("rejectModal");
            rejectModal?.addEventListener("show.bs.modal", function (event) {
                const button = event.relatedTarget;
                document.getElementById("rejectmovementId").value = button.getAttribute("data-movement-id");
                document.getElementById("rejectassetId").value    = button.getAttribute("data-asset-tag");
            });
        });
    </script>
}