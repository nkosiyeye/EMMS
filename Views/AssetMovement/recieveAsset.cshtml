@using EMMS.ViewModels
@using EMMS.Utility
@using static EMMS.Models.Enumerators
@model MoveAssetViewModel;
@{
    ViewData["Title"] = "Recieve Assets";
    ViewData["recieveAsset"] = "active";
    ViewData["JobMovement"] = "active";
    Model.MoveAsset.DateReceived = DateTime.Today;
    //var pagination = (Pagination)ViewData["Pagination"];
}


<!-- Scan to Receive: tick off a whole batch (scanner, camera or checkboxes) -->
<div class="card mb-4" id="scanReceiveCard">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><strong>Scan to Receive</strong> <span id="srBatchLabel" class="text-muted"></span></span>
        <select id="srBatch" class="form-select form-select-sm w-auto">
            <option value="">Loading incoming batches...</option>
        </select>
    </div>
    <div class="card-body">
        <p class="text-muted mb-0" id="srEmpty">No batches are on their way to your facility.</p>
        <div class="row g-4 d-none" id="srBody">
            <div class="col-lg-4">
                <div id="srFrom" class="mb-1"></div>
                <h5 class="text-danger mb-3" id="srCounter"></h5>
                <div class="input-group mb-2">
                    <input type="text" id="srScan" class="form-control form-control-lg font-monospace border-success" placeholder="Scan each asset as it arrives" autocomplete="off" spellcheck="false" />
                    <button type="button" class="btn btn-outline-secondary d-none" id="srCamera" title="Scan with the device camera"><i class="fa fa-camera"></i></button>
                </div>
                <div id="srResult" class="small mb-3" role="status" aria-live="polite"></div>
                <div class="mb-2">
                    <label class="form-label small mb-1" for="srCondition">Condition (optional)</label>
                    <select id="srCondition" class="form-select form-select-sm" asp-items="@(new SelectList(Model.Conditions ?? Enumerable.Empty<EMMS.Models.Entities.LookupItem>(), "Id", "Name"))">
                        <option value="">-</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label small mb-1" for="srRemarks">Remarks (optional)</label>
                    <input id="srRemarks" class="form-control form-control-sm" />
                </div>
                <button type="button" class="btn btn-primary" id="srConfirm" disabled>Confirm Receive (<span id="srConfirmCount">0</span>)</button>
            </div>
            <div class="col-lg-8">
                <div class="table-responsive">
                    <table class="table table-bordered align-middle mb-2">
                        <thead><tr><th style="width:2rem"></th><th>Tag</th><th>Serial</th><th>Item</th><th>Status</th></tr></thead>
                        <tbody id="srItems"></tbody>
                    </table>
                </div>
                <div class="alert alert-danger small d-none" id="srNote">
                    Unscanned assets are flagged for follow-up instead of blocking the receipt: they stay in transit (receive or reject them later) and the sender is notified.
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Pending Asset Receipts Card -->
