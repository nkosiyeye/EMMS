@using EMMS.Utility
@using EMMS.ViewModels
@using static EMMS.Models.Enumerators
@model MoveAssetViewModel;
@{
    ViewData["Title"] = "Move Assets";
    ViewData["moveAsset"] = "active";
    ViewData["JobMovement"] = "active";
    var isAdmin = ViewBag._currrentUserRole.UserType == Enumerators.UserType.Administrator;
    var isManager = ViewBag._currrentUserRole.UserType == Enumerators.UserType.FacilityManager;
}

<div class="card mb-12">
    <div class="card-header">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Movement History</span>
            <div>
                <button type="button" id="clearFilters" class="btn btn-outline-secondary btn-sm me-2 d-none" title="Reset all column filters">
                    <i class="fa fa-filter-circle-xmark me-1"></i> Clear Filters
                </button>
                <a class="btn btn-outline-primary btn-sm me-2" asp-controller="AssetMovement" asp-action="Queue">
                    <i class="fa fa-barcode me-1"></i> Movement Queue
                </a>
                <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#moveModal">
                    <i class="fa fa-plus me-1"></i> Move Asset
                </button>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="table-wrapper">
            <table class="table table-striped table-bordered table-hover" id="movementHistoryTable">
                <thead class="table-dark">
                    <tr>
                        <th>Asset Tag</th>
                        <th>From Facility</th>
                        <th>To Facility</th>
                        <th>Service Point</th>
                        <th>Date Moved</th>
                        <th>Functional Status</th>
                        <th>Reason for Movement</th>
                        <th>Approved</th>
                        <th>Received Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    /* Column filter dropdowns in the dark header */
    #movementHistoryTable thead th {
        vertical-align: top;
    }

    #movementHistoryTable thead select.column-filter {
        width: 100%;
        max-width: 160px;
        margin-top: 4px;
        font-size: 0.8rem;
    }

    #movementHistoryTable thead select.column-filter option {
        background-color: #fff;
        color: #212529;
    }
</style>

<!-- Modal -->
<div class="modal fade" id="moveModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Asset Movement</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="modalAssetBody">
                <div class="table-responsive" id="table-responsive-asset">
                    <div class="table-responsive" id="table-responsive-asset">
                        <table class="table fixed-table table-striped table-bordered table-hover" id="modalAssetTable">
                            <thead>
                                <tr>
                                    <th>Tag</th>
                                    <th>Category</th>
                                    <th>SubCategory</th>
                                    <th>Placement</th>
                                    <th>Location</th>
                                    <th>Functional Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                                </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var isTabletOrSmaller = window.innerWidth <= 1024;

            // Show "Clear Filters" only when at least one column filter is applied
            function syncFilterState() {
                const hasFilters = $('#movementHistoryTable thead select.column-filter').toArray()
                    .some(s => s.value !== '');
                $('#clearFilters').toggleClass('d-none', !hasFilters);
            }

            // Shared helper: adds header dropdown filters to the given columns
            function addColumnFilters(api, columnIndexes) {
                api.columns(columnIndexes).every(function () {
                    const column = this;
                    const select = document.createElement('select');
                    select.add(new Option('All', ''));
                    select.className = 'form-select form-select-sm column-filter';
                    $(column.header()).append(select);

                    // keep the header click from triggering the column sort
                    select.addEventListener('click', e => e.stopPropagation());

                    select.addEventListener('change', () => {
                        const val = select.value;
                        column
                            .search(val ? '^' + val.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '$' : '', true, false)
                            .draw();
                    });

                    // NOTE: with serverSide, this only lists values on the current page.
                    column.data().unique().sort().each(function (d) {
                        select.add(new Option(d, d));
                    });
                });
            }

            const historyFilterColumns = [1, 2, 3, 6];   // From Facility, To Facility, Service Point, Reason

            $('#movementHistoryTable').DataTable({
                serverSide: true,
                processing: true,
                ajax: {
                    url: '@Url.Action("GetMovements", "AssetMovement")',
                    type: 'POST',
                    dataSrc: 'data'
                },
                pageLength: 10,
                responsive: isTabletOrSmaller,
                drawCallback: syncFilterState,
                columns: [
                    { data: "tag", name: "AssetTag" },
                    { data: "fromFacility", name: "FromFacility" },
                    { data: "toFacility", name: "ToFacility" },
                    { data: "servicePoint", name: "ServicePoint" },
                    { data: "dateMoved" },
                    { data: "functionalStatus" },
                    { data: "reasonForMovement", name: "Reason" },
                    {
                        data: null,
                        name: "Approved",
                        orderable: false,
                        searchable: false,
                        render: function (data, type, row) {
                            if (row.isApproved) {
                                return '<span class="badge bg-success">Approved</span>';
                            } else if(row.canApprove) {
                                return `<a class="btn btn-sm btn-success"
                                           href="/AssetMovement/approveMovement/${row.movementId}">
                                           <i class="fa fa-check-circle"></i> Approve
                                       </a>`;
                            } else {
                                return '<span class="badge bg-warning">Pending</span>';
                            }
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        render: function (data, type, row) {
                            if (row.dateRejected) {
                                return '<span class="badge bg-danger">Rejected</span>';
                            } else if (row.dateReceived) {
                                return '<span class="badge bg-success">Received</span>';
                            } else {
                                return '<span class="badge bg-secondary">Pending</span>';
                            }
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        render: function (data, type, row) {
                            let html = '<div class="btn-group btn-group-sm">';

                            // Edit & Delete — only if not received and not approved
                            if (!row.dateReceived && !row.isApproved) {
                                html += `
                                    <a class="btn btn-primary"
                                       href="/AssetMovement/edit/${row.movementId}"
                                       title="Edit">
                                        <i class="fa fa-edit"></i>
                                    </a>
                                    <form action="/AssetMovement/deleteMovement" method="post" style="display:inline;"
                                          onsubmit="return confirm('Delete this movement?');">
                                        <input type="hidden" name="id" value="${row.movementId}" />
                                        <button type="submit" class="btn btn-danger" title="Delete">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </form>`;
                            }

                            // Gate Pass — only if approved
                            if (row.isApproved) {
                                html += `
                                    <a class="btn btn-secondary ms-1"
                                       href="/AssetMovement/GatePass/${row.movementId}"
                                       target="_blank"
                                       title="Print Gate Pass">
                                        <i class="fa fa-print"></i> Pass
                                    </a>`;
                            }

                            // Batch — movements submitted together from the Movement Queue
                            if (row.batchId) {
                                html += `
                                    <a class="btn btn-outline-dark ms-1"
                                       href="/AssetMovement/Batch/${row.batchId}"
                                       title="View batch">
                                        <i class="fa fa-layer-group"></i> Batch
                                    </a>`;
                            }

                            html += '</div>';
                            return html;
                        }
                    }
                ],
                initComplete: function () {
                    addColumnFilters(this.api(), historyFilterColumns);

                    // Clear all column filters at once
                    $('#clearFilters').on('click', function () {
                        $('#movementHistoryTable thead select.column-filter').each(function () {
                            this.value = '';
                        });
                        $('#movementHistoryTable').DataTable()
                            .columns(historyFilterColumns).search('').draw();
                    });
                }
            });

            $('#modalAssetTable').DataTable({
                serverSide: true,
                processing: true,
                ajax: {
                    url: '@Url.Action("GetAssets", "AssetMovement")',
                    type: 'POST',
                    dataSrc: 'data'
                },
                pageLength: 10,
                responsive: isTabletOrSmaller,
                columns: [
                    { data: "tag" },                // Asset Tag
                    { data: "category" },           // Category
                    { data: "subCategory" },        // SubCategory / Item name
                    { data: "placement" },          // Placement (Yes/No)
                    { data: "location" },           // Location (Facility or Service Point)
                    { data: "functionalStatus" },   // Functional Status
                    { data: "action", orderable: false, searchable: false }  // Move Asset button
                ]
            });
        });
    </script>
}
