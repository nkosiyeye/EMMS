@using EMMS.Utility
@using Newtonsoft.Json
@using EMMS.ViewModels
@using static EMMS.Models.Enumerators
@model HomeDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    ViewData["active"] = "active";
    var facilities = ViewData["FacilityId"] as SelectList;
}

<div class="dash">

    @if (Model.Role == UserType.Administrator && facilities != null)
    {
        <form method="get" asp-controller="Home" asp-action="Index" class="dash-filter">
            <label for="dashFacility">Showing</label>
            <select id="dashFacility" name="facilityId" class="form-select form-select-sm" data-dash-autosubmit>
                <option value="">All facilities</option>
                @foreach (var f in facilities)
                {
                    <option value="@f.Value" selected="@f.Selected">@f.Text</option>
                }
            </select>
        </form>
    }

    @foreach (var notice in Model.Notices)
    {
        <div class="dash-notice">
            <span>@notice.Text</span>
            <a asp-controller="@notice.Link.Controller" asp-action="@notice.Link.Action" asp-route-id="@notice.Link.Id">@notice.LinkText</a>
        </div>
    }

    <div class="row g-3 mb-3">
        @foreach (var stat in Model.Stats)
        {
            <div class="col-6 col-xl">
                <partial name="_StatTile" model="stat" />
            </div>
        }
    </div>

    @if (Model.Breakdowns.Count > 0)
    {
        <div class="row g-3 mb-3">
            @foreach (var breakdown in Model.Breakdowns)
            {
                <div class="col-12 col-lg-6">
                    <partial name="_Breakdown" model="breakdown" />
                </div>
            }
        </div>
    }

    @foreach (var table in Model.Tables)
    {
        <div class="mb-3">
            <partial name="_WorkTable" model="table" />
        </div>
    }
</div>

<!-- Toast Notification -->
@if (TempData["Notification"] is string notificationJson)
{
    var notification = JsonConvert.DeserializeObject<ToastNotification>(notificationJson);
    var className = notification?.Type switch
    {
        NotificationType.Error => "error-notification notification",
        NotificationType.Success => "success-notification notification",
        _ => "notification"
    };

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            Toastify({
                text: "@notification?.Message",
                duration: 8000,
                close: true,
                gravity: "top",
                position: "center",
                className: "@className"
            }).showToast();
        });
    </script>
}

@section Scripts {
    <script>
        $(function () {
            // Admin facility filter reloads the dashboard for the chosen facility
            $('[data-dash-autosubmit]').on('change', function () { this.form.submit(); });

            // Same table behaviour as the rest of the app
            $('.js-dash-table').DataTable({ pageLength: 10, order: [] });
        });

        // Breakdown charts: horizontal bars, one series each, value at the bar tip.
        (function () {
            const COLOURS = {            // status palette for equipment status; primary = the single hue for counts
                success: '#0ca30c',
                warning: '#fab219',
                danger: '#d03b3b',
                secondary: '#94a3b8',
                primary: '#2563eb'
            };
            const INK = '#0f172a', MUTED = '#64748b', GRID = '#e2e8f0';

            // Numbers sit at the end of each bar in ink (never in the bar colour)
            const valueAtTip = {
                id: 'dashValueAtTip',
                afterDatasetsDraw(chart) {
                    const { ctx } = chart;
                    const values = chart.data.datasets[0].data;
                    ctx.save();
                    ctx.font = '600 12px system-ui, -apple-system, "Segoe UI", sans-serif';
                    ctx.fillStyle = INK;
                    ctx.textBaseline = 'middle';
                    chart.getDatasetMeta(0).data.forEach((bar, i) => ctx.fillText(values[i].toLocaleString(), bar.x + 6, bar.y));
                    ctx.restore();
                }
            };

            const shorten = (text, max) => text.length > max ? text.slice(0, max - 1) + '…' : text;

            document.querySelectorAll('.js-dash-chart').forEach(canvas => {
                const data = JSON.parse(canvas.dataset.chart);
                new Chart(canvas, {
                    type: 'bar',
                    data: {
                        labels: data.labels,
                        datasets: [{
                            data: data.values,
                            backgroundColor: data.tones.map(t => COLOURS[t] || COLOURS.primary),
                            borderRadius: 4,
                            borderSkipped: 'start',   // rounded at the value end, square at the baseline
                            maxBarThickness: 24
                        }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        layout: { padding: { right: 40 } },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                displayColors: false,
                                callbacks: { label: c => c.parsed.x.toLocaleString() }
                            }
                        },
                        scales: {
                            x: {
                                beginAtZero: true,
                                ticks: { precision: 0, color: MUTED },
                                grid: { color: GRID },
                                border: { display: false }
                            },
                            y: {
                                ticks: {
                                    color: INK,
                                    autoSkip: false,
                                    callback: function (value) { return shorten(this.getLabelForValue(value), 26); }
                                },
                                grid: { display: false },
                                border: { color: GRID }
                            }
                        }
                    },
                    plugins: [valueAtTip]
                });
            });
        })();
    </script>
}
