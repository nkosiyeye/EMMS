<!-- Toast Notification -->
@if (TempData["Notification"] != null)
{
    var notification = JsonConvert.DeserializeObject<ToastNotification>(TempData["Notification"].ToString());
    var className = notification?.Type switch
    {
        NotificationType.Error => "error-notification notification",
        NotificationType.Success => "success-notification notification",
        _ => "notification"
    };

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            Toastify({
                text: "@notification?.Message",
                duration: 8000,
                close: true,
                gravity: "top",
                position: "center",
                className: "@className"
            }).showToast();
        });
    </script>
}
@section Scripts {
    <script>
         //$(".shimmer-card").addClass("loading");
        $(document).ready(function () {
            // Show shimmer for cards while loading
            //$(".shimmer-card").addClass("loading");

            // Show loader for table
            let loaderHtml = `
                        <tr id="tableLoaderRow">
            <td colspan="6" class="text-center py-5">
                <div class="spinner">
                    <div class="bounce1"></div>
                    <div class="bounce2"></div>
                    <div class="bounce3"></div>
                    <p class="mt-2 text-muted">Loading assets...</p>
                </div>
            </td>
        </tr>
        `;
           // $("#assetTableBody").html(loaderHtml);

            let assetTable;
                 assetTable = $('#assetTable').DataTable({
            pageLength: 5,
            responsive: true,
            lengthChange: false,
            ordering: false,
            autoWidth: false
        });

        loadAssets();

            // 🔹 Load Dashboard Cards
            $.getJSON('@Url.Action("GetDashboardCounts")', function (data) {
                $('#totalAssetsCard .card-title').text(data.totalAssets);
                $('#openRequestsCard .card-title').text(data.openRequests);
                $('#completedJobsCard .card-title').text(data.completedJobs);
                $('#pendingJobsCard .card-title').text(data.pendingJobs);

                $('#totalAssetsCard .card-text').text("Assets currently being tracked.");
                $('#openRequestsCard .card-text').text("Work requests that are still open.");
                $('#completedJobsCard .card-text').text("Jobs successfully completed.");
                $('#pendingJobsCard .card-text').text("Jobs awaiting approval or action.");

                // Remove shimmer smoothly
                setTimeout(() => {
                    $(".shimmer").removeClass("loading shimmer");
                    $(".shimmer-text").removeClass("shimmer-text");
                }, 400);
            });

                    function loadAssets() {

            assetTable.clear().draw();

            // Optional loading row
            assetTable.row.add([
                '',
                '', '', `
                <div class="spinner">
                    <div class="bounce1"></div>
                    <div class="bounce2"></div>
                    <div class="bounce3"></div>
                    <p class="mt-2 text-muted">Loading assets...</p>
                </div>`, '', '',''
            ]).draw(false);

            $.getJSON('@Url.Action("GetAssetsDueServiceJson")', function (data) {

                assetTable.clear();

                if (!data || data.length === 0) {
                    assetTable.row.add([
                        '<div class="text-center text-muted">No assets due for service.</div>',
                        '', '', '', '', '',''
                    ]).draw(false);
                    return;
                }

                data.forEach(asset => {

                    const facility = asset.facilityName ?? '';
                    const servicePoint = asset.servicePointName
                        ? `<strong>${asset.servicePointName}</strong>`
                        : '';

                    const location = `${facility} ${servicePoint}`.trim() || 'Not Deployed';


                    assetTable.row.add([
                        asset.assetTagNumber,
                        asset.name,
                        displayProcurementStatus(asset.statusId),
                        location,
                        displayFunctionalStatus(asset.functionalStatus),
                        ` <span>${asset.nextServiceDate}</span>

                            <br />
                            <small class="text-muted">
                                ${asset.overDueService} day(s)
                            </small>`
                         || '-',
                        `
                        <div class="dropdown">
                            <button class="btn btn-sm btn-secondary dropdown-toggle" data-bs-toggle="dropdown">
                                <i class="fa-solid fa-ellipsis"></i>
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" href="/AssetManagement/detail/${asset.assetId}">
                                        <i class="fa fa-eye me-1"></i> View Asset
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="/JobManagement/AutomateServiceRequest/${asset.assetId}">
                                        <i class="fa-solid fa-toolbox me-1"></i> Service Request
                                    </a>
                                </li>
                            </ul>
                        </div>`
                    ]);
                });

                assetTable.draw();
            });
        }

            // 🔹 Helper Functions
            function displayProcurementStatus(procStatus) {
                switch (procStatus) {
                    case 0: return `<div class="status-btn status-new">New</div>`;
                    case 1: return `<div class="status-btn status-info">Used</div>`;
                    case 2: return `<div class="status-btn status-warning">Refurbished</div>`;
                    case 3: return `<div class="status-btn status-danger">Decommissioned</div>`;
                    default: return `<div>-</div>`;
                }
            }

            function displayFunctionalStatus(funcStatus) {
                switch (funcStatus) {
                    case 1: return `<div class="status-btn status-new">Functional</div>`;
                    case 2: return `<div class="status-btn status-danger">NonFunctional</div>`;
                    case 3: return `<div class="status-btn status-warning">UnderMaintenance</div>`;
                    case 4: return `<div class="status-btn status-muted">Unknown</div>`;
                    default: return `<div>-</div>`;
                }
            }
        });

         document.addEventListener("DOMContentLoaded", function () {

            function truncateLabel(label, maxLength = 15) {
                if (!label) return '';
                return label.length > maxLength
                    ? label.substring(0, maxLength) + '...'
                    : label;
            }

            function getLabelsAndValues(obj) {
                return [Object.keys(obj), Object.values(obj)];
            }

                    function renderChart(canvasId, config) {
            const canvas = document.getElementById(canvasId);

            // target card-body, not card
            const cardBody = canvas.closest('.card-body');

            new Chart(canvas, config);

            // hide loader
            cardBody.classList.add('chart-loaded');
        }


            function baseOptions() {
                return {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        tooltip: {
                            callbacks: {
                                title: t => t[0].label
                            }
                        }
                    },
                    scales: {
                        x: {
                            ticks: {
                                callback: function (value) {
                                    return truncateLabel(this.getLabelForValue(value), 18);
                                }
                            }
                        },
                        y: {
                            beginAtZero: true
                        }
                    }
                };
            }

            fetch('/Home/GetDashboardChartData')
                .then(res => res.json())
                .then(data => {

                    /* Functional Status */
                    {
                        const [labels, values] = getLabelsAndValues(data.functionalStatusCounts);
                        renderChart('functionalStatusChart', {
                            type: 'bar',
                            data: {
                                labels,
                                datasets: [{
                                    label: 'Functional Status',
                                    data: values,
                                    backgroundColor: 'rgba(54,162,235,0.6)'
                                }]
                            },
                            options: baseOptions()
                        });
                    }

                    /* Procurement Status */
                    {
                        const [labels, values] = getLabelsAndValues(data.procurementStatusCounts);
                        renderChart('procurementStatusChart', {
                            type: 'bar',
                            data: {
                                labels,
                                datasets: [{
                                    label: 'Procurement Status',
                                    data: values,
                                    backgroundColor: 'rgba(16,185,129,0.6)'
                                }]
                            },
                            options: baseOptions()
                        });
                    }

                    /* Movement Reason */
                    {
                        const [labels, values] = getLabelsAndValues(data.movementReasonCounts);
                        renderChart('movementReasonChart', {
                            type: 'bar',
                            data: {
                                labels,
                                datasets: [{
                                    label: 'Movement Reason',
                                    data: values,
                                    backgroundColor: 'rgba(99,102,241,0.6)'
                                }]
                            },
                            options: baseOptions()
                        });
                    }

                    /* Non Functional By Facility */
                    {
                        const [labels, values] = getLabelsAndValues(data.nonFunctionalByFacilityCounts);
                        renderChart('nonFunctionalByFacilityChart', {
                            type: 'bar',
                            data: {
                                labels,
                                datasets: [{
                                    label: 'Non Functional Assets',
                                    data: values,
                                    backgroundColor: 'rgba(239,68,68,0.6)'
                                }]
                            },
                            options: baseOptions()
                        });
                    }

                });

        });

    </script>
}





