@model IEnumerable<EMMS.Models.Admin.User>

@{

    ViewData["Title"] = "Manage Users";
    ViewData["UserManagement"] = "active";
    ViewData["userAccounts"] = "active";

    const string NoFacility = "No facility";
    string FacilityOf(EMMS.Models.Admin.User u) => u.Facility?.FacilityName ?? NoFacility;
    string RoleOf(EMMS.Models.Admin.User u) => u.UserRole?.Name ?? "No role";

    // Header filter options, keyed by DataTables column name. This table is client-side, so each value is the
    // cell's data-search text (site.js emmsColumnFilters matches it exactly).
    object Options(IEnumerable<string> values) => values.Distinct().OrderBy(v => v).Select(v => new { text = v, value = v });
    var filterOptionsJson = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object>
    {
        ["Gender"] = Options(Model.Select(u => u.Gender.ToString())),
        ["Facility"] = Options(Model.Select(FacilityOf)),
        ["Role"] = Options(Model.Select(RoleOf)),
        ["Status"] = Options(Model.Select(u => u.RowState.ToString())),
    });
}

<div class="card">
    <div class="card-header">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>User Accounts</span>
            <div class="d-flex justify-content-between align-items-center">
                <button type="button" id="clearFilters" class="btn btn-outline-secondary btn-sm me-2 d-none" title="Reset all column filters">
                    <i class="fa fa-filter-circle-xmark me-1"></i> Clear Filters
                </button>
                <a class="btn btn-primary btn-sm" asp-action="Create">
                    <i class="fa fa-plus me-1"></i> Create New
                </a>
                <a class="btn btn-primary btn-sm" style="margin-left:2px;" title="Export to Excel" data-no-loading asp-action="Export">
                    <i class="fa fa-download"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive" id="table-responsive-asset">
            <div class="table-responsive" id="table-responsive-asset">
                <table class="table fixed-table table-striped table-bordered table-hover" id="userTable">
                    <thead>
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.FirstName)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.LastName)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.DOB)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Gender)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Cellphone)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Facility)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Username)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.UserRole)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.RowState)
                            </th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.FirstName)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.LastName)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.DOB)
                                </td>
                                <td data-search="@item.Gender">
                                    @Html.DisplayFor(modelItem => item.Gender)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Cellphone)
                                </td>
                                <td data-search="@FacilityOf(item)">
                                    @Html.DisplayFor(modelItem => item.Facility.FacilityName)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Username)
                                </td>
                                <td data-search="@RoleOf(item)">
                                    @Html.DisplayFor(modelItem => item.UserRole.Name)
                                </td>
                                <td data-search="@item.RowState">
                                    @if (item.RowState == Enumerators.RowStatus.Active)
                                    {
                                        <span class="badge bg-success">
                                            @Html.DisplayFor(modelItem => item.RowState)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @Html.DisplayFor(modelItem => item.RowState)
                                        </span>
                                    }
                                </td>
                                <td>
                                    <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.UserId">Edit</a> 
                                    <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.UserId">Details</a>
									@if (item.RowState == Enumerators.RowStatus.Active)
									{
                                        <a class="btn btn-sm btn-warning" asp-action="ActivateUser" asp-route-id="@item.UserId">Deactivate</a>
									}
									else
									{
                                        <a class="btn btn-sm btn-success" asp-action="ActivateUser" asp-route-id="@item.UserId">Activate</a>
									}
                                    @* <a asp-action="Delete" asp-route-id="@item.UserId">Delete</a> *@
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>

        </div>

    </div>
</div>


@section Scripts {
    <script>
        $(document).ready(function () {
            const filterOptions = @Html.Raw(filterOptionsJson);

            $('#userTable').DataTable({
                pageLength: 10,
                columns: [
                    null, null, null,
                    { name: "Gender" },
                    null,
                    { name: "Facility" },
                    null,
                    { name: "Role" },
                    { name: "Status" },
                    { orderable: false, searchable: false }
                ],
                // Show "Clear Filters" only while a column filter is applied
                drawCallback: function () {
                    const hasFilters = $('#userTable thead select.column-filter').toArray().some(s => s.value !== '');
                    $('#clearFilters').toggleClass('d-none', !hasFilters);
                },
                // ?Status=Inactive (the dashboard's "waiting for activation" banner) presets the Status filter
                initComplete: function () {
                    emmsColumnFilters(this.api(), filterOptions, '#clearFilters');
                }
            });
        });

    </script>
}


